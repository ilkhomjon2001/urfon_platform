# --- Majburiy ---
# PostgreSQL ulanishi (lokal dev: `npm run db:start` shu manzilda embedded Postgres ko'taradi)
DATABASE_URL=postgresql://urfon:urfon@localhost:5433/urfon
# Kamida 32 belgili tasodifiy satr: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Ixtiyoriy ---
NODE_ENV=development
PORT=3000
# Production'da web ilova manzili (CORS va cookie uchun)
APP_ORIGIN=http://localhost:5173
# Yuklangan fayllar papkasi
UPLOAD_DIR=./uploads
# Telegram bot (bo'sh bo'lsa bot o'chiq, xabarlar navbatda qoladi). @BotFather dan olinadi.
# USERNAME — botning haqiqiy nomi (@ siz): ulash havolasi t.me/<USERNAME>?start=<kod> shundan yasaladi
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=urfon_bot
# Turniket integratsiyasi: POST /api/integrations/turnstile, sarlavha X-Api-Key. Bo'sh bo'lsa endpoint o'chiq (404).
# Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TURNSTILE_API_KEY=
# Birinchi admin (npm run db:seed:prod -w api)
ADMIN_LOGIN=+998900000000
ADMIN_PASSWORD=
ADMIN_NAME=Bosh administrator
# Demo ma'lumotlar (KANON hikoyasi) — faqat demo/staging uchun
DEMO_PASSWORD=urfon2024

# --- Production (docker compose, deploy/README-DEPLOY.md) ---
# Domen bo'lsa:   APP_ORIGIN=https://platforma.urfon.uz   SITE_ADDRESS=platforma.urfon.uz  (Caddy avtomatik HTTPS)
# Domen yo'q:     APP_ORIGIN=http://SERVER_IP              SITE_ADDRESS=:80                 (oddiy HTTP)
SITE_ADDRESS=:80
APP_ORIGIN=
# O'z Caddy'miz (80/443) bilan: COMPOSE_PROFILES=caddy. 80/443 band bo'lgan umumiy serverda: bo'sh qoldiring va
# APP_BIND=0.0.0.0, APP_PORT=4900, TRUST_PROXY=false, APP_ORIGIN=http://SERVER_IP:4900
COMPOSE_PROFILES=caddy
APP_BIND=127.0.0.1
APP_PORT=3000
# Filial nomi (birinchi o'rnatishda, db:seed:prod)
BRANCH_NAME=URFON oʻquv markazi
# Postgres paroli — faqat harf va raqam (URL ichiga tushadi): openssl rand -hex 24
POSTGRES_PASSWORD=
